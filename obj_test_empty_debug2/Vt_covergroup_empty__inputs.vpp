//   Arguments: --cc --coverage test_regress/t/t_covergroup_empty.v -Mdir obj_test_empty_debug2 -Wno-IMPLICITSTATIC --debug
//   Build jobs: 1
//   Verilate jobs: 1

// verilator fargs --cc
// verilator fargs --coverage
// verilator fargs -Wno-IMPLICITSTATIC

`begin_keywords "1800-2023"
module t ( 
   clk
   );
   input clk;
   logic [7:0] value;
   covergroup cg_empty;
   endgroup
   cg_empty cg_inst = new;
   int cyc = 0;
   always @(posedge clk) begin
      cyc <= cyc + 1;
      value <= value + 1;
      cg_inst.sample();
      if (cyc == 5) begin
         begin
            real cov;
            cov = cg_inst.get_inst_coverage();
            $display("Empty covergroup coverage: %f%%", cov);
            if (cov >= 99.9) begin
               $write("*-* All Finished *-*\n");
               $finish;
            end else begin
               $display("ERROR: Expected 100%% coverage for empty covergroup, got %f%%", cov);
               $stop;
            end
         end
      end
      if (cyc > 10) begin
         $display("ERROR: Test timed out");
         $stop;
      end
   end
endmodule
