            $display("Empty covergroup coverage: %f%%", cov);
            
             
            if (cov >= 99.9) begin
               $write("*-* All Finished *-*\n");
               $finish;
            end else begin
               $display("ERROR: Expected 100%% coverage for empty covergroup, got %f%%", cov);
               $stop;
            end
         end
      end
      
      if (cyc > 10) begin
         $display("ERROR: Test timed out");
         $stop;
      end
   end
endmodule

