// Dump of all post-preprocessor input
// Blank lines and `line directives have been removed
//
// Information:
//   Version: Verilator 5.045 devel rev v5.044-164-g9b6c2d019 (mod)
//   Arguments: --coverage-user --debug 4 -cc test_regress/t/t_covergroup_autobins.v -Mdir obj_test_autobins
//   Build jobs: 1
//   Verilate jobs: 1

// verilator fargs --coverage-user
// verilator fargs -cc

`begin_keywords "1800-2023"
module t( 
   clk
   );
   input clk;
   logic [2:0] data3;   
   logic [1:0] data2;   
   covergroup cg1;
      cp_data3: coverpoint data3;   
   endgroup
   covergroup cg2;
      option.auto_bin_max = 4;
      cp_data3: coverpoint data3;   
   endgroup
   covergroup cg3;
      cp_data3: coverpoint data3 {
         ignore_bins reserved = {7};
      }
   endgroup
   covergroup cg4;
      cp_data2: coverpoint data2;   
   endgroup
   covergroup cg5;
      option.auto_bin_max = 2;
      cp_data2: coverpoint data2;   
   endgroup
   initial begin
      cg1 cg1_inst;
      cg2 cg2_inst;
      cg3 cg3_inst;
      cg4 cg4_inst;
      cg5 cg5_inst;
      cg1_inst = new;
      cg2_inst = new;
      cg3_inst = new;
      cg4_inst = new;
      cg5_inst = new;
      data3 = 0; cg1_inst.sample();
      data3 = 1; cg1_inst.sample();
      data3 = 2; cg1_inst.sample();
      data3 = 0; cg2_inst.sample();
      data3 = 1; cg2_inst.sample();
      data3 = 4; cg2_inst.sample();
      data3 = 0; cg3_inst.sample();
      data3 = 1; cg3_inst.sample();
      data3 = 7; cg3_inst.sample();   
      data2 = 0; cg4_inst.sample();
      data2 = 1; cg4_inst.sample();
      data2 = 2; cg4_inst.sample();
      data2 = 3; cg4_inst.sample();
      data2 = 0; cg5_inst.sample();
      data2 = 3; cg5_inst.sample();
      $display("CG1 (8 autobins): %0.1f%%", cg1_inst.get_inst_coverage());
      $display("CG2 (4 autobins w/ option): %0.1f%%", cg2_inst.get_inst_coverage());
      $display("CG3 (7 autobins w/ ignore): %0.1f%%", cg3_inst.get_inst_coverage());
      $display("CG4 (4 autobins): %0.1f%%", cg4_inst.get_inst_coverage());
      $display("CG5 (2 autobins w/ option): %0.1f%%", cg5_inst.get_inst_coverage());
      if (cg1_inst.get_inst_coverage() < 30.0 || cg1_inst.get_inst_coverage() > 45.0)
         $stop;
      if (cg3_inst.get_inst_coverage() < 20.0 || cg3_inst.get_inst_coverage() > 45.0)
         $stop;
      if (cg4_inst.get_inst_coverage() < 95.0)
         $stop;
      $write("*-* All Finished *-*\n");
      $finish;
   end
endmodule
